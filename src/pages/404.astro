---
import BaseLayout from '@layouts/BaseLayout.astro';
---
<BaseLayout title="Page not found" noindex>
  <div class="wrap wrap-narrow center" style="padding-block:60px">
    <p class="eyebrow">404</p>
    <h1>This page is not here</h1>
    <p class="lede" style="margin-inline:auto">The chapter may not be written yet, or the link is old.</p>
    <p><a class="btn" href="/">Go to all semesters</a></p>
  </div>
</BaseLayout>
