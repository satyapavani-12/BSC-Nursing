---
interface Props {
  title?: string;
  note?: string;
}
const { title = 'One heartbeat, one pulse', note = 'Each heartbeat pushes a wave of blood into the arteries. That wave is what you feel as the pulse — count it for 60 seconds.' } = Astro.props;
---
<div class="anim" data-anim>
  <div class="anim-head">
    <h3>{title}</h3>
    <button class="anim-btn" type="button" data-anim-toggle aria-pressed="false">⏸ Pause</button>
  </div>
  <svg viewBox="0 0 640 180" role="img" aria-label="Animated pulse wave showing one heartbeat">
    <defs>
      <linearGradient id="pwBg" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#fbfdfc" />
        <stop offset="100%" stop-color="#f1f7f5" />
      </linearGradient>
    </defs>

    <rect x="0" y="0" width="640" height="180" fill="url(#pwBg)" rx="10" />
    <g stroke="#d9e6e2" stroke-width="1">
      <line x1="20" y1="45" x2="620" y2="45" />
      <line x1="20" y1="90" x2="620" y2="90" />
      <line x1="20" y1="135" x2="620" y2="135" />
    </g>

    <path
      d="M20 110 H120 l14 0 l10 -46 l14 82 l12 -36 h20 l8 0 H320 l14 0 l10 -46 l14 82 l12 -36 h20 l8 0 H620"
      fill="none"
      stroke="#c9dcd6"
      stroke-width="3"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
    <path
      class="pw-trace"
      d="M20 110 H120 l14 0 l10 -46 l14 82 l12 -36 h20 l8 0 H320 l14 0 l10 -46 l14 82 l12 -36 h20 l8 0 H620"
      fill="none"
      stroke="#0c6b60"
      stroke-width="3.5"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
    <circle class="pw-dot" cx="20" cy="110" r="5" fill="#0c6b60" />

    <text x="30" y="30" font-size="12" fill="#556b64" font-weight="700">Pulse wave</text>
    <text x="470" y="165" font-size="11" fill="#556b64">time →</text>
  </svg>
  <p class="anim-note">{note}</p>
</div>

<style>
  .pw-trace {
    stroke-dasharray: 640;
    stroke-dashoffset: 640;
    animation: pw-draw 4s linear infinite;
  }

  @keyframes pw-draw {
    0% { stroke-dashoffset: 640; }
    75% { stroke-dashoffset: 0; }
    100% { stroke-dashoffset: 0; opacity: 1; }
  }

  .pw-dot {
    animation: pw-travel 4s linear infinite;
  }

  @keyframes pw-travel {
    0% { transform: translate(0, 0); opacity: 0; }
    10% { opacity: 1; }
    75% { transform: translate(600px, 0); opacity: 1; }
    76%, 100% { opacity: 0; }
  }

  .is-paused .pw-trace,
  .is-paused .pw-dot {
    animation-play-state: paused;
  }
</style>

